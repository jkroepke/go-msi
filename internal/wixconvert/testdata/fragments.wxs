<?xml version="1.0" encoding="UTF-8"?>
<!-- A sample package split into fragments, with references that come
     before the elements they name. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Fragment>
    <DirectoryRef Id="INSTALLFOLDER">
      <Directory Id="PluginDir" Name="plugins" />
    </DirectoryRef>
    <ComponentGroup Id="Plugins" Directory="PluginDir">
      <Component Id="PluginA">
        <File Id="plugin_a.dll" Source="dist\plugins\a.dll" />
      </Component>
    </ComponentGroup>
    <FeatureRef Id="Main">
      <ComponentGroupRef Id="Plugins" />
    </FeatureRef>
  </Fragment>

  <Fragment>
    <FeatureGroup Id="Optional">
      <ComponentRef Id="Notes" />
      <Feature Id="Samples" Title="Samples" Level="2">
        <ComponentRef Id="SampleFile" />
      </Feature>
    </FeatureGroup>
  </Fragment>

  <Package Name="$(var.ProductName)" Manufacturer="Example" Version="1.0.0" UpgradeCode="5d9b2f3a-7c1e-4b8d-9f0a-2e6c4a8b1d37" Scope="perMachine">
    <Upgrade Id="5d9b2f3a-7c1e-4b8d-9f0a-2e6c4a8b1d37">
      <UpgradeVersion Minimum="0.0.1" Maximum="1.0.0" Property="OLDERFOUND" />
    </Upgrade>
    <Property Id="GREETING" Value="Welcome to !(bind.Property.ProductName)" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Hello" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenu" Name="Hello" />
    </StandardDirectory>

    <Component Id="MainExe" Directory="INSTALLFOLDER" util:Extra="1">
      <?if $(var.Arch) = "arm64" ?>
      <File Id="hello.exe" Source="dist\arm64\hello.exe" />
      <?else?>
      <File Id="hello.exe" Source="dist\x64\hello.exe" />
      <?endif?>
    </Component>
    <Component Id="Notes" Directory="INSTALLFOLDER">
      <File Id="notes.txt" Source="dist\notes.txt" />
    </Component>
    <Component Id="SampleFile" Directory="INSTALLFOLDER">
      <File Id="sample.txt" Source="dist\sample.txt" />
    </Component>
    <Component Id="MenuEntry" Directory="AppMenu">
      <Shortcut Id="HelpShortcut" Name="Hello Help" Advertise="yes" />
      <RemoveFolder Id="RemoveAppMenu" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Example\Hello" Name="menu" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="Hello">
      <ComponentRef Id="MainExe" />
      <ComponentRef Id="MenuEntry" />
      <FeatureGroupRef Id="Optional" />
    </Feature>
  </Package>
</Wix>
