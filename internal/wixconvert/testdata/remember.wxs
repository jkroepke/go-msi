<?xml version="1.0" encoding="windows-1252"?>
<!-- A per-user sample, declared windows-1252, that remembers its data folder and
     removes it on uninstall. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi" xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <Product Id="*" Name="Hello" Language="1033" Version="1.0.0" Manufacturer="Example"
           UpgradeCode="{0B7C3D2E-5F41-4A6B-8C9D-1E2F3A4B5C6D}">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser" Platform="x64" Description="Hello edition" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="AppDataExample" Name="Example">
          <Directory Id="AppDataHello" Name="Hello">
            <Component Id="MainExecutable" Guid="{1C2D3E4F-5061-4728-9A3B-4C5D6E7F8091}">
              <File Source="hello.exe" KeyPath="yes" />
            </Component>
          </Directory>
        </Directory>
      </Directory>
    </Directory>

    <!-- The data folder that the uninstall removes. -->
    <Property Id="DATAPATH">
      <RegistrySearch Id="DataPathSearch" Root="HKCU" Key="Software\Example\Hello" Name="DataPath" Type="raw" />
    </Property>
    <Property Id="CACHEPATH">
      <RegistrySearch Id="CachePathSearch" Root="HKCU" Key="Software\Example\Hello" Name="CachePath" Type="raw" />
    </Property>
    <DirectoryRef Id="AppDataExample">
      <Component Id="CleanupData" Guid="{2D3E4F50-6172-4839-AB4C-5D6E7F809102}">
        <RegistryKey Root="HKCU" Key="Software\Example">
          <RegistryValue Key="Hello" Name="DataPath" Type="string" Value="[AppDataExample]" KeyPath="yes" />
        </RegistryKey>
        <util:RemoveFolderEx On="uninstall" Property="DATAPATH" />
      </Component>
      <!-- Removes a folder that the component does not remember. -->
      <Component Id="CleanupCache" Guid="{3E4F5061-7283-494A-BC5D-6E7F80910213}">
        <RegistryValue Root="HKCU" Key="Software\Example\Hello" Name="Cache" Type="string" Value="[AppDataExample]" KeyPath="yes" />
        <util:RemoveFolderEx On="uninstall" Property="CACHEPATH" />
        <!-- Empties the folder before the install. -->
        <util:RemoveFolderEx On="install" />
      </Component>
    </DirectoryRef>

    <Feature Id="Complete" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="CleanupData" />
      <ComponentRef Id="CleanupCache" />
    </Feature>
  </Product>
</Wix>
